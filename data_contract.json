{
  "contract_name": "Iris_Classifier_Inference_Data_Contract",
  "contract_version": "1.0.0",
  "experiment_name": "Proyecto_Final_Grado",
  "target_endpoint": "/predict",
  "schema": {
    "required_fields": ["sepal_length", "sepal_width", "petal_length", "petal_width"],
    "properties": {
      "sepal_length": {"type": "float", "nullable": false, "min": 4.0, "max": 8.0},
      "sepal_width":  {"type": "float", "nullable": false, "min": 2.0, "max": 4.5},
      "petal_length": {"type": "float", "nullable": false, "min": 1.0, "max": 7.0},
      "petal_width":  {"type": "float", "nullable": false, "min": 0.1, "max": 2.5}
    }
  },
  "examples": {
    "valid_input": {
      "description": "Entrada válida: tipos float correctos, sin valores nulos y dentro de rangos lógicos.",
      "payload": {
        "sepal_length": 5.1,
        "sepal_width": 3.5,
        "petal_length": 1.4,
        "petal_width": 0.2
      }
    },
    "invalid_input": {
      "description": "Entrada inválida: fuera de rango (12.5), valor nulo (null), tipo incorrecto ('texto') y negativo (-0.5).",
      "payload": {
        "sepal_length": 12.5,
        "sepal_width": null,
        "petal_length": "texto_invalido",
        "petal_width": -0.5
      }
    }
  }
}
